# Copy these values into your shell before starting the server.
# PowerShell:  $env:FARM_ADMIN_TOKEN = "a-long-random-string"
#              $env:SEED_DEMO_DATA = "1"   # only for a demo database
# CMD:         set FARM_ADMIN_TOKEN=a-long-random-string

# Required. Used by the X-Admin-Token header for all writes and exports.
FARM_ADMIN_TOKEN=replace-with-a-long-random-string

# Optional, defaults to 8000.
PORT=8000

# Optional, defaults to 0. Set to 1 ONLY if you want three sample cows inserted
# into a brand-new empty database. Never use this for real records.
SEED_DEMO_DATA=0
