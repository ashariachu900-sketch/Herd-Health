# Copy to .env for Docker Compose, or export these values in your shell for local runs.
# PowerShell:  $env:FARM_ADMIN_TOKEN = "a-long-random-string"
#              $env:FARM_VET_TOKEN = "a-different-long-random-string"
# CMD:         set FARM_ADMIN_TOKEN=a-long-random-string

# Required. Entered once in the farmer workspace and exchanged for an HttpOnly
# session cookie. Header tokens remain supported for CLI/backup clients.
FARM_ADMIN_TOKEN=replace-with-a-long-random-string

# Required. Used by the X-Vet-Token header for /api/animals/<id>/verify.
# Must be different from FARM_ADMIN_TOKEN so a farmer cannot self-certify records.
FARM_VET_TOKEN=replace-with-a-different-long-random-string

# Dashboard domain for automatic HTTPS (Docker Compose only). Use localhost for local testing.
CADDY_DOMAIN=localhost

# Optional application settings.
PORT=8000
# Local runs default to 127.0.0.1. Docker Compose overrides this to 0.0.0.0
# because the app is only exposed to the proxy on an internal network.
BIND_HOST=127.0.0.1
# Set to 1 behind HTTPS so browser session cookies get the Secure flag.
COOKIE_SECURE=0
# Set persistent paths when running outside Docker. The parent directory is created automatically.
CATTLECARE_DB=./cattlecare.db
CATTLECARE_UPLOADS=./uploads
# Set to enable a rotating server.log (e.g. ./logs).
CATTLECARE_LOG_DIR=

# Optional, defaults to 0. Set to 1 ONLY if you want three sample cows inserted
# into a brand-new empty database. Never use this for real records.
SEED_DEMO_DATA=0

# backup.py settings. The admin token above is reused to call /api/export.
APP_URL=http://127.0.0.1:8000
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30
