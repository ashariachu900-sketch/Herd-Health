# Set CADDY_DOMAIN in .env to your real DNS name before going live.
# Caddy obtains and renews a TLS certificate automatically.
{$CADDY_DOMAIN:localhost} {
    encode gzip

    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        Permissions-Policy "geolocation=(), microphone=(), camera=()"
        Content-Security-Policy "default-src 'self'; connect-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
    }

    # HSTS is only appropriate on a real TLS hostname. Never pin localhost.
    @production {
        not host localhost 127.0.0.1 ::1
    }
    header @production Strict-Transport-Security "max-age=31536000; includeSubDomains"

    # The app throttles failed tokens per IP (5 per 5 minutes). If you want a
    # second layer at the proxy, add the caddy-ratelimit plugin to the image.
    reverse_proxy app:8000

    log {
        output stdout
    }
}
